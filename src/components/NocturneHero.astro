---
import Arrow from './Arrow.astro';
const scenes = [
  {image:'nocturne-pool.jpg',alt:'Contemporary villa with a private swimming pool and open terraces',label:'LIFE, BEAUTIFULLY OPEN',title:'More light.',accent:'More living.',description:'Open skies, beautiful architecture and space to unwind. A new perspective on coming home.',name:'Your own private escape',category:'Poolside living',interest:'Private villas'},
  {image:'nocturne-living.jpg',alt:'Sunlit contemporary lounge with warm leather, natural materials and generous windows',label:'THE ART OF SLOW LIVING',title:'A life',accent:'less ordinary.',description:'Beautiful spaces. A deeper sense of belonging. Discover a home that moves you.',name:'Spaces that stay with you',category:'Considered interiors',interest:'City residences'},
  {image:'nocturne-residence.jpg',alt:'Distinctive contemporary residence surrounded by greenery and a private garden',label:'ROOM FOR YOUR NEXT CHAPTER',title:'A world',accent:'of your own.',description:'A little more space. A little more possibility. A place to live entirely on your terms.',name:'Privacy. Presence. Possibility.',category:'Private residences',interest:'Private villas'},
  {image:'nocturne-sanctuary.jpg',alt:'Refined contemporary living space with soft light and carefully selected natural materials',label:'BEAUTY IN EVERY DETAIL',title:'An address.',accent:'A feeling.',description:'Beyond the architecture, beyond the view. Find the quiet certainty that you are home.',name:'The extraordinary, every day',category:'Personal sanctuaries',interest:'Waterfront residences'},
  {image:'nocturne-penthouse.jpg',alt:'Contemporary timber and dark metal residence opening onto a leafy garden',label:'NATURE AT YOUR DOOR',title:'Find your',accent:'quiet place.',description:'Where considered architecture meets the outdoors. Discover a home with room to breathe.',name:'Architecture in harmony',category:'Garden residences',interest:'Private villas'},
  {image:'nocturne-retreat.jpg',alt:'Carefully styled living room with warm materials and contemporary furnishings',label:'THE FINER SIDE OF EVERYDAY',title:'Live with',accent:'intention.',description:'Textures that invite you in. Details that make you stay. Beautiful living, thoughtfully considered.',name:'Warmth in every detail',category:'Refined interiors',interest:'City residences'},
  {image:'nocturne-architecture.jpg',alt:'Illuminated Sheikh Zayed Grand Mosque in Abu Dhabi reflected in water at dusk',label:'A PLACE OF POSSIBILITY',title:'A new',accent:'perspective.',description:'Remarkable places. An open horizon. Find your next chapter in the United Arab Emirates.',name:'An extraordinary setting',category:'Abu Dhabi at dusk',interest:'Living in the UAE'},
];
---
<section class="nocturne-hero" aria-roledescription="carousel" aria-label="The Nocturne collection" data-scenes={JSON.stringify(scenes)} tabindex="0">
<div class="nocturne-topline"><span class="eyebrow"><i></i> MANNATH — THE PRIVATE EDIT</span><span class="eyebrow">UAE REAL ESTATE, PERSONALLY CONSIDERED</span></div>
<div class="nocturne-stage"><div class="nocturne-copy"><span class="eyebrow nocturne-kicker" data-scene-label>{scenes[0].label}</span><h1 class="nocturne-title"><span class="nocturne-word"><span data-scene-title>{scenes[0].title}</span></span><span class="nocturne-word"><em data-scene-accent>{scenes[0].accent}</em></span></h1><p data-scene-description>{scenes[0].description}</p><a href="#collection" class="nocturne-cta"><span>Discover your extraordinary</span><span class="nocturne-cta-icon"><Arrow/></span></a><div class="nocturne-signature"><span class="signature-line"></span><span>Not just where you live.<br/>How you feel.</span></div></div>
<div class="nocturne-gallery"><div class="nocturne-images">{scenes.map((scene,index)=><figure class:list={['nocturne-slide',{'is-active':index===0}]} aria-hidden={index!==0} role="group" aria-roledescription="slide" aria-label={`${index+1} of ${scenes.length}: ${scene.category}`}><img src={'/images/'+scene.image} alt={scene.alt} width="1800" height="1350" loading="eager" decoding="async"/></figure>)}<div class="nocturne-image-gradient"></div><span class="nocturne-image-top">THE BEAUTY OF BELONGING</span><div class="nocturne-image-caption"><span class="eyebrow" data-scene-category>{scenes[0].category}</span><span data-scene-name>{scenes[0].name}</span></div><a class="nocturne-enquire" href={'/contact/?interest='+encodeURIComponent(scenes[0].interest)} aria-label="Enquire about this collection"><Arrow/></a></div><div class="nocturne-rail"><div class="nocturne-pagination"><span class="nocturne-current">01</span><div class="nocturne-dots" role="group" aria-label="Choose a slide">{scenes.map((scene,index)=><button type="button" data-slide={index} aria-label={`Show slide ${index+1}: ${scene.category}`} aria-current={index===0?'true':undefined}><span></span></button>)}</div><span class="nocturne-total">{String(scenes.length).padStart(2,'0')}</span></div><div class="nocturne-controls"><button type="button" data-carousel-pause aria-label="Pause slideshow" aria-pressed="false"><span class="pause-symbol">Ⅱ</span><span class="play-symbol">▷</span></button><button type="button" data-carousel-prev aria-label="Previous slide"><Arrow/></button><button type="button" data-carousel-next aria-label="Next slide"><Arrow/></button></div></div></div></div>
<div class="nocturne-bottom"><a href="#introduction"><span class="nocturne-down">↓</span> A DIFFERENT PERSPECTIVE AWAITS</a><span>CURATED WITH INTENTION. CHOSEN FOR YOU.</span><span class="nocturne-edition">THE NOCTURNE EDIT <i>№ 03</i></span></div><span class="sr-only" data-carousel-status role="status" aria-live="polite"></span>
</section>
<script>
interface Scene { label:string;title:string;accent:string;description:string;name:string;category:string;interest:string; }
const root=document.querySelector<HTMLElement>('.nocturne-hero');
if(root){
const scenes:Scene[]=JSON.parse(root.dataset.scenes||'[]');const slides=Array.from(root.querySelectorAll<HTMLElement>('.nocturne-slide'));const dots=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-slide]'));const pause=root.querySelector<HTMLButtonElement>('[data-carousel-pause]');const reduced=matchMedia('(prefers-reduced-motion: reduce)');let index=0,userPaused=reduced.matches,focused=false,inView=false;let timer:ReturnType<typeof setTimeout>|undefined;
const canPlay=()=>document.documentElement.dataset.theme==='three'&&!userPaused&&!focused&&!reduced.matches&&!document.hidden&&inView;
const schedule=()=>{clearTimeout(timer);root.classList.toggle('is-playing',canPlay());if(canPlay())timer=setTimeout(()=>show(index+1,false),5000);};
const syncPause=()=>{pause?.setAttribute('aria-pressed',String(userPaused));pause?.setAttribute('aria-label',userPaused?'Play slideshow':'Pause slideshow');};syncPause();
function show(next:number,manual=true){index=(next+scenes.length)%scenes.length;const scene=scenes[index];slides.forEach((slide,i)=>{slide.classList.toggle('is-active',i===index);slide.setAttribute('aria-hidden',String(i!==index));});dots.forEach((dot,i)=>{if(i===index)dot.setAttribute('aria-current','true');else dot.removeAttribute('aria-current');});const fields:Record<string,string>={'title':scene.title,'accent':scene.accent,'description':scene.description,'label':scene.label,'name':scene.name,'category':scene.category};for(const [key,value] of Object.entries(fields)){const el=root?.querySelector('[data-scene-'+key+']');if(el)el.textContent=value;}const count=root?.querySelector('.nocturne-current');if(count)count.textContent=String(index+1).padStart(2,'0');root?.querySelector('.nocturne-enquire')?.setAttribute('href','/contact/?interest='+encodeURIComponent(scene.interest));root?.classList.remove('words-enter');if(root){void root.offsetWidth;root.classList.add('words-enter');}if(manual){const status=root?.querySelector('[data-carousel-status]');if(status)status.textContent=`Slide ${index+1} of ${scenes.length}: ${scene.category}`;}schedule();}
root.querySelector('[data-carousel-next]')?.addEventListener('click',()=>show(index+1));root.querySelector('[data-carousel-prev]')?.addEventListener('click',()=>show(index-1));dots.forEach(dot=>dot.addEventListener('click',()=>show(Number(dot.dataset.slide))));pause?.addEventListener('click',()=>{userPaused=!userPaused;syncPause();schedule();});root.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();show(index+(event.key==='ArrowRight'?1:-1));}});
root.addEventListener('focusin',event=>{focused=event.target instanceof HTMLElement&&event.target.matches(':focus-visible');schedule();});root.addEventListener('focusout',()=>{requestAnimationFrame(()=>{focused=root.contains(document.activeElement)&&document.activeElement instanceof HTMLElement&&document.activeElement.matches(':focus-visible');schedule();});});let touchStart=0;const gallery=root.querySelector<HTMLElement>('.nocturne-images');gallery?.addEventListener('touchstart',event=>{touchStart=event.changedTouches[0].clientX;},{passive:true});gallery?.addEventListener('touchend',event=>{const delta=event.changedTouches[0].clientX-touchStart;if(Math.abs(delta)>55)show(index+(delta<0?1:-1));},{passive:true});
new IntersectionObserver(entries=>{inView=entries[0].isIntersecting;schedule();},{threshold:.2}).observe(root);new MutationObserver(schedule).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});document.addEventListener('visibilitychange',schedule);reduced.addEventListener('change',()=>{if(reduced.matches)userPaused=true;syncPause();schedule();});root.classList.add('words-enter');
}
</script>
