---
interface Props {src:string;alt:string;width:string|number;height:string|number;loading?:'lazy'|'eager';fetchpriority?:'high'|'low'|'auto';class?:string;}
const {src,alt,class:imageClass,...attrs}=Astro.props;
const kind=src.includes('interior')?'interior':src.includes('dubai')?'coast':'desert';
const descriptions={interior:'Conceptual penthouse with a sculptural staircase and panoramic windows',coast:'Conceptual coastal residence with rounded terraces at twilight',desert:'Conceptual sculptural desert villa beside a reflecting pool'};
---
<img class:list={['original-theme-image',imageClass]} src={src} alt={alt} {...attrs}/><img class:list={['folio-theme-image',imageClass]} src={'/images/folio-'+kind+'.jpg'} alt={descriptions[kind]} {...attrs}/>
{['seven','eight','nine'].map((theme)=><img class:list={['reference-theme-image',`reference-image-${theme}`,imageClass]} src={'/images/'+({seven:'signal',eight:'amethyst',nine:'terra'}[theme])+'-'+(kind==='interior'?'interior':kind==='desert'?'retreat':'architecture')+'.jpg'} alt={kind==='interior'?'Illustrative contemporary residential interior':'Illustrative architectural inspiration'} {...attrs}/>)}
<style is:global>.reference-theme-image{display:none}html[data-theme=seven] .original-theme-image,html[data-theme=eight] .original-theme-image,html[data-theme=nine] .original-theme-image{display:none}html[data-theme=seven] .reference-image-seven,html[data-theme=eight] .reference-image-eight,html[data-theme=nine] .reference-image-nine{display:block}.folio-theme-image{display:none}html[data-theme=six] .original-theme-image{display:none}html[data-theme=six] .folio-theme-image{display:block}</style>
