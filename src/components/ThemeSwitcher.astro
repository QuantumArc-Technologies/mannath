---
const themes = [
  { id: 'seven', number: '07', name: 'Signal', description: 'Charcoal grey · moonlit silver · signal red', swatch: 'swatch-seven' },
  { id: 'eight', number: '08', name: 'Amethyst', description: 'Jet black · royal amethyst · electric cyan', swatch: 'swatch-eight' },
  { id: 'nine', number: '09', name: 'Terra', description: 'Sage green · walnut brown · amber glow', swatch: 'swatch-nine' },
  { id: 'six', number: '06', name: 'Folio', description: 'Aubergine · orchid · acid yellow', swatch: 'swatch-six' },
  { id: 'five', number: '05', name: 'Riviera', description: 'Electric blue · ice blue · vermilion', swatch: 'swatch-five' },
  { id: 'four', number: '04', name: 'Aurelia', description: 'Olive · burnished copper · champagne', swatch: 'swatch-four' },
  { id: 'one', number: '01', name: 'Evergreen', description: 'Forest green · ivory · muted gold', swatch: 'swatch-one' },
  { id: 'two', number: '02', name: 'Atelier', description: 'Espresso · alabaster · bronze', swatch: 'swatch-two' },
  { id: 'three', number: '03', name: 'Nocturne', description: 'Midnight · champagne · muted rose', swatch: 'swatch-three' },
];
---
<button type="button" class="theme-launcher" aria-haspopup="dialog" aria-controls="theme-drawer" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18h1.3a2.2 2.2 0 0 0 1.5-3.8 1.3 1.3 0 0 1 .9-2.2h1.6A3.7 3.7 0 0 0 21 11.3 8.7 8.7 0 0 0 12 3Z" stroke="currentColor" stroke-width="1.4"/><circle cx="7.5" cy="11" r="1" fill="currentColor"/><circle cx="10" cy="7" r="1" fill="currentColor"/><circle cx="15" cy="7.5" r="1" fill="currentColor"/></svg><span>Themes</span><span class="launcher-current sr-only">01</span></button>
<dialog id="theme-drawer" class="theme-drawer" aria-labelledby="theme-drawer-title"><div class="drawer-heading"><span class="eyebrow">THE MANNATH EDIT</span><button type="button" class="drawer-close" aria-label="Close theme selector"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.4"/></svg></button></div><div class="drawer-intro"><h2 id="theme-drawer-title">A different<br/><em>perspective.</em></h2><p>Choose the atmosphere that feels like you.</p></div><div class="theme-options" role="group" aria-label="Website theme">{themes.map(theme=><button type="button" data-theme-choice={theme.id} data-theme-number={theme.number} aria-pressed={theme.id==='one'?'true':'false'}><span class:list={['theme-swatch',theme.swatch]}></span><span class="theme-option-copy"><small>THEME {theme.number}</small><strong>{theme.name}</strong><span>{theme.description}</span></span><span class="theme-check" aria-hidden="true">✓</span></button>)}</div><div class="drawer-bottom"><span class="eyebrow">YOUR SPACE. YOUR STYLE.</span><p>Your choice stays with you as you explore.</p></div></dialog><span id="theme-status" class="sr-only" role="status"></span>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
const drawer=document.querySelector<HTMLDialogElement>('#theme-drawer');
const launcher=document.querySelector<HTMLButtonElement>('.theme-launcher');
const sync=()=>buttons.forEach(button=>{const active=button.dataset.themeChoice===(document.documentElement.dataset.theme||'one');button.setAttribute('aria-pressed',String(active));if(active){const number=document.querySelector('.launcher-current');if(number)number.textContent=button.dataset.themeNumber||'';}});sync();
launcher?.addEventListener('click',()=>{drawer?.showModal();launcher.setAttribute('aria-expanded','true');document.documentElement.classList.add('theme-drawer-open');});
drawer?.addEventListener('close',()=>{launcher?.setAttribute('aria-expanded','false');document.documentElement.classList.remove('theme-drawer-open');});
document.querySelector('.drawer-close')?.addEventListener('click',()=>drawer?.close());
drawer?.addEventListener('click',event=>{if(event.target!==drawer)return;const bounds=drawer.getBoundingClientRect();if(event.clientX<bounds.left||event.clientX>bounds.right||event.clientY<bounds.top||event.clientY>bounds.bottom)drawer.close();});
buttons.forEach(button=>button.addEventListener('click',()=>{const theme=button.dataset.themeChoice||'one';if(theme===document.documentElement.dataset.theme){drawer?.close();return;}document.documentElement.dataset.theme=theme;const url=new URL(location.href);url.searchParams.delete('theme');history.replaceState(null,'',url);try{localStorage.setItem('mannath-theme',theme);}catch{}document.querySelector('meta[name="theme-color"]')?.setAttribute('content',theme==='seven'?'#2A2A2A':theme==='eight'?'#050505':theme==='nine'?'#87A96B':theme==='six'?'#321c3e':theme==='five'?'#254bea':theme==='four'?'#29372c':theme==='three'?'#101b29':theme==='two'?'#241e1b':'#183d35');sync();const status=document.querySelector('#theme-status');if(status)status.textContent=theme==='seven'?'Signal theme selected.':theme==='eight'?'Amethyst theme selected.':theme==='nine'?'Terra theme selected.':theme==='six'?'Folio theme selected.':theme==='five'?'Riviera theme selected.':theme==='four'?'Aurelia theme selected.':theme==='three'?'Nocturne theme selected.':theme==='two'?'Atelier theme selected.':'Evergreen theme selected.';drawer?.close();window.scrollTo({top:0,behavior:'instant'});}));
</script>

<style is:global>
/* The collection lives in a scrollable sidebar, ready for additional themes. */
.theme-launcher{position:fixed;right:24px;bottom:24px;z-index:40;display:flex;align-items:center;gap:11px;padding:13px 16px;background:var(--cream);color:var(--ink);border:1px solid var(--gold);box-shadow:0 5px 28px #0000001c;font-size:11px;transition:transform .25s,box-shadow .25s}.theme-launcher:hover{transform:translateY(-3px);box-shadow:0 8px 30px #0000002c}.launcher-current{font-size:9px;padding-left:11px;border-left:1px solid var(--line);color:var(--gold)}.theme-drawer{position:fixed;inset:0 0 0 auto;margin:0;width:min(430px,100vw);height:100dvh;max-width:100vw;max-height:100dvh;padding:30px;overflow-y:auto;overscroll-behavior:contain;border:0;border-left:1px solid var(--line);background:var(--cream);color:var(--ink)}.theme-drawer[open]{display:flex;flex-direction:column;animation:drawerEnter .35s cubic-bezier(.2,.7,.2,1)}.theme-drawer::backdrop{background:#11171366;backdrop-filter:blur(5px)}.drawer-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-bottom:25px;border-bottom:1px solid var(--line)}.drawer-heading .eyebrow{font-size:9px}.drawer-close{width:36px;height:36px;display:grid;place-items:center;border:1px solid var(--line);background:transparent;color:var(--ink)}.drawer-close:hover{border-color:var(--gold)}.drawer-intro{padding:37px 0 30px}.drawer-intro h2{font-size:51px;letter-spacing:-1.6px}.drawer-intro p{font-size:11px;margin-top:18px}.theme-drawer .theme-options{display:flex;flex-direction:column;gap:12px;margin:0;padding-bottom:35px}.theme-drawer .theme-options button{display:flex;width:100%;min-width:0;gap:17px;align-items:center;text-align:left;padding:22px 18px;background:transparent;color:var(--ink);border:1px solid var(--line);transition:background .25s,border-color .25s}.theme-drawer .theme-options button:hover{background:#b9a1780d;border-color:var(--gold)}.theme-drawer .theme-options button[aria-pressed=true]{border-color:var(--gold);background:#b9a17815}.theme-swatch{width:43px;height:43px;border-radius:50%;flex-shrink:0;border:1px solid #00000012}.swatch-one{background:linear-gradient(135deg,#183d35 50%,#b9a178 50%)}.swatch-two{background:linear-gradient(135deg,#241e1b 50%,#ba8c64 50%)}.theme-drawer .theme-option-copy{display:flex;flex-direction:column;gap:5px;flex:1;min-width:0;line-height:1.3}.theme-drawer .theme-option-copy small{font-size:7px;letter-spacing:1.8px;font-family:var(--sans)}.theme-option-copy strong{font-family:var(--serif);font-size:31px;font-weight:400}.theme-option-copy>span{font-family:var(--sans);font-size:8px;letter-spacing:0;color:var(--muted)}.theme-check{visibility:hidden;font-size:15px;color:var(--gold)}.theme-options button[aria-pressed=true] .theme-check{visibility:visible}.drawer-bottom{margin-top:auto;border-top:1px solid var(--line);padding-top:24px}.drawer-bottom .eyebrow{font-size:8px}.drawer-bottom p{font-size:10px;margin-top:8px}.theme-drawer-open{overflow:hidden}@keyframes drawerEnter{from{transform:translateX(100%);opacity:.5}to{transform:translateX(0);opacity:1}}@media(max-width:700px){.theme-launcher{right:16px;bottom:16px;padding:11px 14px}.theme-drawer{width:min(390px,100vw);padding:25px}.drawer-intro h2{font-size:46px}}@media(prefers-reduced-motion:reduce){.theme-drawer[open]{animation:none}}

.theme-launcher{right:28px;bottom:max(28px,env(safe-area-inset-bottom));z-index:1000;min-height:58px;gap:12px;padding:9px 23px 9px 10px;border-radius:999px;border:1px solid #c2a67c;background:#201e1a;color:#fbf7ef;box-shadow:0 8px 30px #0004,0 2px 5px #0002;font:500 12px/1.4 var(--sans,Arial,sans-serif);letter-spacing:.4px;isolation:isolate;cursor:pointer;appearance:none;}
.theme-launcher>svg{box-sizing:content-box;padding:10px;border-radius:50%;background:#b9a17825;color:#e3c59c;flex-shrink:0;width:19px;height:19px;}
.theme-launcher:hover{background:#302a22;transform:translateY(-4px);box-shadow:0 12px 35px #0005;}
.theme-launcher:focus-visible{outline:2px solid #e3c59c;outline-offset:5px;}
.theme-launcher .launcher-current{position:absolute;width:1px;height:1px;padding:0;border:0;}
@media(max-width:700px){.theme-launcher{right:16px;bottom:max(18px,env(safe-area-inset-bottom));min-height:52px;padding:7px 20px 7px 8px;gap:10px;font-size:11px;}.theme-launcher>svg{padding:9px;width:18px;height:18px;}}
</style>
