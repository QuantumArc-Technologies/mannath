---
import '../styles/global.css';
import '../styles/atelier.css';
import '../styles/nocturne.css';
import '../styles/aurelia.css';
import '../styles/riviera.css';
import '../styles/folio.css';
import '../styles/responsive.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import Logo from '../components/Logo.astro';
import Arrow from '../components/Arrow.astro';
interface Props { title: string; description: string; }
const {title, description} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html><html lang="en" data-theme="six"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#321c3e"/><script is:inline>
try { const requested = new URLSearchParams(location.search).get('theme'); const names = { '1':'one', '2':'two', '3':'three', '4':'four', '5':'five', '7':'seven', '8':'eight', '9':'nine', seven:'seven', eight:'eight', nine:'nine', '6':'six', one:'one', two:'two', three:'three', four:'four', five:'five', six:'six' }; const saved = localStorage.getItem('mannath-folio-default-seen') ? localStorage.getItem('mannath-theme') : 'six'; const theme = names[requested] || saved || 'six'; if (['one','two','three','four','five','six','seven','eight','nine'].includes(theme)) document.documentElement.dataset.theme = theme; localStorage.setItem('mannath-folio-default-seen','1'); localStorage.setItem('mannath-theme',theme); } catch {}
const referenceColors = {seven:'#2A2A2A',eight:'#050505',nine:'#87A96B'};
if(referenceColors[document.documentElement.dataset.theme]) document.querySelector('meta[name="theme-color"]').setAttribute('content',referenceColors[document.documentElement.dataset.theme]);
if(document.documentElement.dataset.theme === 'six') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#321c3e');
if(document.documentElement.dataset.theme === 'five') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#254bea');
if(document.documentElement.dataset.theme === 'four') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#29372c');
if(document.documentElement.dataset.theme === 'three') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#101b29');
if(document.documentElement.dataset.theme === 'two') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#241e1b');
</script><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/hero.jpg', Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" type="image/svg+xml" href="/logo-mark.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,500;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization', name:'Mannath Real Estate',url:Astro.site,logo:new URL('/logo-mark.svg',Astro.site),areaServed:{'@type':'Country',name:'United Arab Emirates'}})}/></head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="header"><div class="nav-shell"><Logo/><nav aria-label="Main navigation" id="main-nav"><a href="/" aria-current={path==='/'?'page':undefined}>Home</a><a href="/#collection">The collection</a><a href="/about/" aria-current={path==='/about/'?'page':undefined}>Our story</a><a href="/contact/" aria-current={path==='/contact/'?'page':undefined}>Contact</a></nav><a href="/contact/" class="nav-cta">Let’s talk <Arrow/></a><button class="menu-toggle" aria-label="Open navigation" aria-controls="main-nav" aria-expanded="false"><span></span><span></span></button></div></header>
<main id="main"><slot/></main>
<ThemeSwitcher/><footer><div class="footer-top"><div><Logo/><p>Exceptional places.<br/>Extraordinary possibilities.</p></div><div><span class="eyebrow">EXPLORE</span><a href="/">Home</a><a href="/#collection">The collection</a><a href="/about/">Our story</a></div><div><span class="eyebrow">LET’S CONNECT</span><a href="/contact/">Start a conversation ↗</a><p>United Arab Emirates</p></div><div class="footer-note"><span class="eyebrow">A NEW PERSPECTIVE</span><p>Thoughtfully curated real estate.<br/>Rooted in the UAE.</p><a href="/contact/" class="text-link">Find your place <Arrow/></a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Mannath Real Estate.</span><span>Made for a life beyond ordinary.</span><a href="#" class="back-top">Back to top ↑</a></div></footer>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
toggle?.addEventListener('click',()=>{const expanded=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!expanded));document.querySelector('.header')?.classList.toggle('menu-open',!expanded);});
const closeMenu=()=>{toggle?.setAttribute('aria-expanded','false');document.querySelector('.header')?.classList.remove('menu-open');};
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){closeMenu();toggle.focus();}});
document.addEventListener('click',event=>{if(event.target instanceof Node&&!document.querySelector('.header')?.contains(event.target))closeMenu();});
matchMedia('(max-width: 1000px)').addEventListener('change',closeMenu);
document.querySelectorAll('#main-nav a').forEach(a=>a.addEventListener('click',()=>{toggle?.setAttribute('aria-expanded','false');document.querySelector('.header')?.classList.remove('menu-open');}));
document.documentElement.classList.add('reveal-ready');
const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target);}}),{threshold:0.1});document.querySelectorAll('[data-reveal]').forEach(el=>observer.observe(el));
</script></body></html>
