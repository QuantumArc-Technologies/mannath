---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
---
<Layout title="Contact Mannath | Begin Your UAE Property Journey" description="Tell Mannath what you are looking for. Start a personal conversation about your next home or real estate opportunity in the UAE.">
<section class="contact-section section"><div class="contact-copy"><span class="eyebrow">LET’S CONNECT</span><h1>Something<br/>extraordinary<br/>starts with <em>hello.</em></h1><p>A new home. A fresh perspective. A question worth asking.<br/>We’d love to hear what you have in mind.</p><div class="contact-location"><span class="eyebrow">WHERE OUR STORY BEGINS</span><h3>United Arab Emirates</h3><p>Rooted here. Focused on you.</p></div><img class="contact-photo" src="/images/villa.jpg" alt="Contemporary home opening onto a private pool" width="800" height="450"/></div><div class="form-panel"><span class="eyebrow">YOUR NEXT CHAPTER</span><h2>Let’s make it <em>personal.</em></h2><p>Tell us a little about yourself and what you’re looking for.</p><form id="enquiry-form"><div class="form-row"><label>First name <span>*</span><input name="firstName" autocomplete="given-name" placeholder="Your first name" required maxlength="80"/></label><label>Last name <span>*</span><input name="lastName" autocomplete="family-name" placeholder="Your last name" required maxlength="80"/></label></div><label>Email address <span>*</span><input name="email" type="email" autocomplete="email" placeholder="you@example.com" required/></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="+971"/></label><label>I’m interested in <span>*</span><select name="interest" id="interest" required><option value="">Select your interest</option><option>Waterfront residences</option><option>Private villas</option><option>City residences</option><option>Living in the UAE</option><option>Selling a property</option><option>Something else</option></select></label><label>A little more about your plans<textarea name="message" rows="3" maxlength="3000" placeholder="The place, the feeling, the possibilities…"></textarea></label><label class="checkbox-label"><input type="checkbox" required/><span>I agree that Mannath may contact me about my enquiry. <a href="#privacy">How we use your details</a></span></label><button class="button button-green" type="submit">Prepare my enquiry <Arrow/></button><p class="form-status" role="status" aria-live="polite"></p><p class="form-note">Preview form: your enquiry is prepared on this device. Delivery will be enabled when Mannath’s contact details are confirmed.</p></form><div class="privacy-note" id="privacy"><h3>Your details, treated thoughtfully.</h3><p>This preview does not transmit or store your personal details. The live site’s contact and privacy details will be added before launch.</p></div></div></section>
<dialog id="enquiry-dialog"><button class="dialog-close" aria-label="Close enquiry preview">×</button><span class="eyebrow">YOUR ENQUIRY, READY</span><h2>A new chapter <em>awaits.</em></h2><p>This is a preview. Your enquiry has not been sent. You can copy the details below for your records.</p><pre id="enquiry-summary"></pre><button class="button button-green" id="copy-enquiry">Copy enquiry <Arrow/></button><p id="copy-status" role="status"></p></dialog>
<script>
const form=document.querySelector<HTMLFormElement>('#enquiry-form');const dialog=document.querySelector<HTMLDialogElement>('#enquiry-dialog');const summary=document.querySelector<HTMLElement>('#enquiry-summary');const interest=new URLSearchParams(location.search).get('interest');const select=document.querySelector<HTMLSelectElement>('#interest');if(interest&&select){const match=Array.from(select.options).find(o=>o.value.toLowerCase()===interest.toLowerCase());if(match)select.value=match.value;}
form?.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);if(summary)summary.textContent=`Name: ${data.get('firstName')} ${data.get('lastName')}\nEmail: ${data.get('email')}\nPhone: ${data.get('phone')||'Not provided'}\nInterest: ${data.get('interest')}\n\n${data.get('message')||''}`;dialog?.showModal();});document.querySelector('.dialog-close')?.addEventListener('click',()=>dialog?.close());dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});document.querySelector('#copy-enquiry')?.addEventListener('click',async()=>{const status=document.querySelector('#copy-status');try{await navigator.clipboard.writeText(summary?.textContent||'');if(status)status.textContent='Enquiry copied.';}catch{if(status)status.textContent='Please select and copy the enquiry text above.';}});
</script>
</Layout>
