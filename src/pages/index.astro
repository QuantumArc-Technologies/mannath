---
import ThemeImage from '../components/ThemeImage.astro';
import FolioHero from '../components/FolioHero.astro';
import RivieraHero from '../components/RivieraHero.astro';
import AureliaHero from '../components/AureliaHero.astro';
import Layout from '../layouts/Layout.astro';
import AtelierHero from '../components/AtelierHero.astro';
import NocturneHero from '../components/NocturneHero.astro';
import Arrow from '../components/Arrow.astro';
const collection=[{name:'The art of waterfront living',area:'WATERFRONT RESIDENCES',image:'dubai.jpg',tag:'By the water',description:'A slower rhythm. An endless horizon.'},{name:'A world of your own',area:'PRIVATE VILLAS',image:'villa.jpg',tag:'Space to breathe',description:'Privacy, presence, and room to grow.'},{name:'Above the everyday',area:'CITY RESIDENCES',image:'interior.jpg',tag:'An elevated perspective',description:'Considered spaces. Connected living.'}];
---
<Layout title="Mannath Real Estate | Exceptional Homes in the UAE" description="Discover a considered approach to UAE real estate with Mannath. Explore waterfront living, private villas and city residences, with guidance shaped around you.">
<FolioHero/>
<RivieraHero/>
<AureliaHero/>
<AtelierHero/>
<NocturneHero/>
<section class="hero"><img class="hero-image" src="/images/hero.jpg" alt="Dubai skyline at sunset with the Burj Khalifa and contemporary architecture" width="2400" height="1600" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content"><span class="eyebrow hero-kicker"><span></span> DISTINCTIVE HOMES. EXCEPTIONAL LIVING.</span><h1>A place to live.<br/>A life to <em>love.</em></h1><p>Extraordinary homes. Thoughtfully chosen.<br/>Discover your next chapter in the UAE.</p><a href="#collection" class="button button-cream">Explore the collection <Arrow/></a></div><div class="hero-bottom"><a href="#introduction" class="scroll-cue"><span>↓</span> SCROLL TO DISCOVER</a><div class="hero-location"><span class="location-dot"></span> ROOTED IN THE UAE. OPEN TO POSSIBILITY.</div><span class="hero-count">01 <span>/ 01</span></span></div><div class="hero-side">A DIFFERENT PERSPECTIVE ON REAL ESTATE</div></section>
<section class="intro section" id="introduction"><div data-reveal><span class="eyebrow">THE MANNATH PERSPECTIVE</span><h2>Some places are lived in.<br/>Others are <em>felt.</em></h2></div><div class="intro-copy" data-reveal><p>That first step through the door. The light across the room. The quiet certainty that you belong.</p><p>At Mannath, we look beyond an address. We bring a considered approach to finding a home in the UAE — connecting your aspirations with spaces that feel unmistakably yours.</p><a href="/about/" class="text-link">Discover our story <Arrow/></a></div></section>
<section class="collection section" id="collection"><div class="section-heading" data-reveal><div><span class="eyebrow">A CONSIDERED COLLECTION</span><h2>Exceptional spaces.<br/><em>Infinite possibilities.</em></h2></div><p>From the energy of the city to the calm of the coast.<br/>Find the way you want to live.</p></div><div class="collection-grid">{collection.map((item,i)=><a class="property-card" href={'/contact/?interest='+encodeURIComponent(item.area)} data-reveal><div class="property-image"><ThemeImage src={'/images/'+item.image} alt={item.name+' — illustrative architectural inspiration'} width="800" height="1000" loading="lazy"/><span class="property-tag">{item.tag}</span><span class="round-arrow"><Arrow/></span><span class="property-index">0{i+1}</span></div><div class="property-meta"><span class="eyebrow">{item.area}</span><h3>{item.name}</h3><p>{item.description}</p></div></a>)}</div><div class="collection-bottom"><span>Images and collections are lifestyle inspiration, not advertised property listings.</span><a class="text-link" href="/contact/">Find your perfect fit <Arrow/></a></div></section>
<section class="philosophy"><div class="philosophy-image"><ThemeImage src="/images/interior.jpg" alt="Warm natural materials and carefully considered details in a contemporary home" width="1400" height="1700" loading="lazy"/><span class="image-caption">THE DETAILS MAKE THE DIFFERENCE.</span></div><div class="philosophy-content" data-reveal><span class="eyebrow">PERSONAL BY NATURE</span><h2>Your ambitions.<br/>Our <em>attention.</em></h2><p>A home is personal. Finding one should be, too. We begin by listening — to what matters to you, how you want to live, and what comes next.</p><div class="principle"><span>01</span><div><h3>Thoughtfully curated</h3><p>A focused approach to finding spaces that suit your life.</p></div></div><div class="principle"><span>02</span><div><h3>Personally guided</h3><p>Clear conversations and considered support at every step.</p></div></div><div class="principle"><span>03</span><div><h3>Rooted in possibility</h3><p>A fresh perspective on the places you could call home.</p></div></div><a href="/about/" class="text-link">The Mannath approach <Arrow/></a></div></section>
<section class="destination section"><div class="destination-heading" data-reveal><span class="eyebrow">AN EXTRAORDINARY PLACE TO CALL HOME</span><h2>The world comes here.<br/><em>You could belong here.</em></h2><p>A meeting point of cultures, coastlines, and possibility.<br/>Experience life in the United Arab Emirates.</p><a class="button button-green" href="/contact/?interest=Living%20in%20the%20UAE">Explore a new beginning <Arrow/></a></div><div class="destination-image" data-reveal><ThemeImage src="/images/dubai.jpg" alt="The distinctive architecture and skyline of Dubai, United Arab Emirates" width="1200" height="1400" loading="lazy"/><span>25.2048° N &nbsp; 55.2708° E</span><div>DUBAI<small>A city of possibility</small></div></div></section>
<section class="cta-section" data-reveal><span class="eyebrow">YOUR NEXT CHAPTER STARTS WITH A CONVERSATION</span><h2>Let’s find your<br/><em>somewhere special.</em></h2><a class="button button-cream" href="/contact/">Begin your journey <Arrow/></a><span class="cta-watermark" aria-hidden="true">M</span></section>
</Layout>
